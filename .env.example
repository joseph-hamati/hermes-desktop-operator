HERMES_OPERATOR_API_TOKEN=change-me-local-token
HERMES_OPERATOR_HOST=127.0.0.1
HERMES_OPERATOR_PORT=8765
HERMES_OPERATOR_DRY_RUN=false
HERMES_OPERATOR_GLOBAL_TASK_TIMEOUT_SECONDS=300
HERMES_OPERATOR_ACTION_TIMEOUT_SECONDS=30
HERMES_OPERATOR_DATA_DIR=./data
HERMES_OPERATOR_LOG_DIR=./logs
HERMES_OPERATOR_AUDIT_LOG=./audit/audit.jsonl
HERMES_OPERATOR_ALLOWED_PROGRAMS=notepad.exe,calc.exe
HERMES_OPERATOR_ALLOWED_DIRECTORIES=%USERPROFILE%\Desktop
HERMES_OPERATOR_OLLAMA_URL=http://127.0.0.1:11434
HERMES_OPERATOR_OLLAMA_MODEL=llama3.1:8b
HERMES_OPERATOR_OLLAMA_TIMEOUT_SECONDS=45
HERMES_OPERATOR_OLLAMA_TEMPERATURE=0.1
HERMES_OPERATOR_EMERGENCY_STOP_HOTKEY=ctrl+alt+shift+q
